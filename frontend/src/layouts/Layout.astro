---
import TopNav from '../components/TopNavigation.astro'
import '../styles/global.css'
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hangry Herbivore — Affordable Vegan Meals</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&display=swap" rel="stylesheet">
  <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- Optional: Apple Touch Icon -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Optional: Multiple sizes -->
    <link rel="icon" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" sizes="16x16" href="/favicon-16x16.png" />
	<link rel="icon" sizes="192x192" href="android-chrome-192x192.png" />
  <style is:global>
    :root {
      --sage-dark:    #3d4f1c;
      --sage-mid:     #6b7c45;
      --sage-light:   #a8bc72;
      --sage-pale:    #dde8c0;
      --sage-wash:    #f0f5e4;
      --cream:        #fdfbf4;
      --cream-warm:   #f5f0e0;
      --yellow:       #f0c419;
      --yellow-deep:  #c49c0a;
      --text-dark:    #2a3412;
      --text-mid:     #5a6e30;
      --text-muted:   #8a9e60;
    }

    * { box-sizing: border-box; }

    body {
      background: var(--cream);
      color: var(--text-dark);
      font-family: "DM Sans", sans-serif;
      font-size: 16px;
      line-height: 1.6;
      margin: 0;
    }

    h1, h2, h3, h4 {
      font-family: "Lora", serif;
      color: var(--sage-dark);
      line-height: 1.25;
    }

    a { text-decoration: none; color: inherit; }

    /* ── NAV ── */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--cream);
      border-bottom: 1.5px solid var(--sage-pale);
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
      margin: 0; padding: 0;
    }

    .nav-links a {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-mid);
      letter-spacing: 0.02em;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--sage-dark); }

    .nav-logo {
      font-family: "Lora", serif;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--sage-dark);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .nav-logo .leaf {
      width: 28px; height: 28px;
      background: var(--yellow);
      border-radius: 50% 50% 50% 0;
      transform: rotate(-45deg);
      display: inline-block;
      flex-shrink: 0;
    }

    .nav-cta {
      background: var(--yellow);
      color: var(--text-dark);
      font-size: 0.8125rem;
      font-weight: 700;
      padding: 0.5rem 1.1rem;
      border-radius: 100px;
      transition: background 0.2s, transform 0.15s;
    }
    .nav-cta:hover { background: var(--yellow-deep); transform: translateY(-1px); }

    /* ── HERO ── */
    .hero {
      max-width: 1100px;
      margin: 0 auto;
      padding: 5rem 2rem 4rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--sage-pale);
      color: var(--sage-dark);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.4rem 0.9rem;
      border-radius: 100px;
      margin-bottom: 1.25rem;
    }

    .hero h1 {
      font-size: clamp(2rem, 4vw, 3rem);
      margin-bottom: 1.25rem;
      font-weight: 700;
    }

    .hero h1 em {
      font-style: italic;
      color: var(--sage-mid);
    }

    .hero p {
      font-size: 1.05rem;
      color: var(--text-mid);
      margin-bottom: 2rem;
      max-width: 440px;
    }

    .btn-row { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; }

    .btn-primary {
      background: var(--yellow);
      color: var(--text-dark);
      font-weight: 700;
      font-size: 0.9375rem;
      padding: 0.85rem 1.75rem;
      border-radius: 100px;
      transition: background 0.2s, transform 0.15s;
      display: inline-block;
    }
    .btn-primary:hover { background: var(--yellow-deep); transform: translateY(-2px); }

    .btn-outline {
      border: 1.5px solid var(--sage-pale);
      color: var(--sage-dark);
      font-weight: 600;
      font-size: 0.9375rem;
      padding: 0.85rem 1.75rem;
      border-radius: 100px;
      transition: background 0.2s, border-color 0.2s;
      display: inline-block;
    }
    .btn-outline:hover { background: var(--sage-wash); border-color: var(--sage-light); }

    .hero-image-wrap {
      position: relative;
    }

    .hero-img {
      width: 100%;
      aspect-ratio: 4/3;
      background: var(--sage-pale);
      border-radius: 24px;
      overflow: hidden;
      position: relative;
    }

    /* Decorative dots pattern */
    .hero-img::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, var(--sage-light) 1.5px, transparent 1.5px);
      background-size: 18px 18px;
      opacity: 0.35;
    }

    .hero-img-placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      color: var(--text-muted);
      letter-spacing: 0.04em;
    }

    /* Floating badge */
    .hero-badge {
      position: absolute;
      bottom: -1rem;
      left: -1.5rem;
      background: var(--yellow);
      border-radius: 16px;
      padding: 0.85rem 1.1rem;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }
    .hero-badge .badge-num {
      font-family: "Lora", serif;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-dark);
      display: block;
      line-height: 1;
    }
    .hero-badge .badge-label {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--sage-dark);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    /* ── VALUE BAR ── */
    .value-bar {
      background: var(--sage-dark);
      padding: 1.1rem 2rem;
    }
    .value-bar-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 2.5rem;
      justify-content: center;
      align-items: center;
    }
    .value-bar span {
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--sage-pale);
      letter-spacing: 0.03em;
    }
    .value-bar .divider {
      width: 4px; height: 4px;
      background: var(--sage-mid);
      border-radius: 50%;
    }

    /* ── SECTION HEADERS ── */
    .section-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 2rem;
    }
    .section-header h2 { font-size: 1.625rem; margin: 0; }
    .section-header a {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--sage-mid);
      border-bottom: 1.5px solid var(--sage-pale);
      padding-bottom: 1px;
      transition: border-color 0.2s, color 0.2s;
    }
    .section-header a:hover { color: var(--sage-dark); border-color: var(--sage-mid); }

    /* ── RECIPE CARDS ── */
    .featured { max-width: 1100px; margin: 0 auto; padding: 4rem 2rem; }

    .recipe-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .recipe-card {
      background: #fff;
      border-radius: 20px;
      border: 1.5px solid var(--sage-pale);
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
      display: block;
    }
    .recipe-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(61,79,28,0.1);
      border-color: var(--sage-light);
    }

    .recipe-card-img {
      background: var(--sage-wash);
      aspect-ratio: 16/10;
      position: relative;
      overflow: hidden;
    }
    .recipe-card-img::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, var(--sage-pale) 0%, var(--cream-warm) 100%);
      opacity: 0.5;
    }

    .recipe-card-body { padding: 1.1rem 1.25rem 1.25rem; }
    .recipe-card-body h3 {
      font-size: 1rem;
      font-weight: 700;
      margin: 0 0 0.5rem;
      color: var(--sage-dark);
      transition: color 0.2s;
    }
    .recipe-card:hover h3 { color: var(--sage-mid); }

    .recipe-meta {
      display: flex;
      gap: 0.75rem;
      font-size: 0.8125rem;
      color: var(--text-muted);
    }
    .recipe-meta .tag {
      background: var(--sage-wash);
      color: var(--sage-mid);
      padding: 0.2rem 0.6rem;
      border-radius: 100px;
      font-weight: 600;
      font-size: 0.75rem;
    }

    /* ── CATEGORIES ── */
    .categories { background: var(--sage-wash); padding: 4rem 2rem; }
    .categories-inner { max-width: 1100px; margin: 0 auto; }

    .cat-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .cat-card {
      background: #fff;
      border: 1.5px solid var(--sage-pale);
      border-radius: 16px;
      padding: 1.5rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      transition: background 0.2s, border-color 0.2s, transform 0.15s;
    }
    .cat-card:hover {
      background: var(--cream);
      border-color: var(--sage-mid);
      transform: translateY(-2px);
    }
    .cat-icon {
      width: 44px; height: 44px;
      background: var(--sage-pale);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      flex-shrink: 0;
    }
    .cat-card h3 {
      font-family: "DM Sans", sans-serif;
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--sage-dark);
      margin: 0 0 0.15rem;
    }
    .cat-card p {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin: 0;
    }

    /* ── HOW IT WORKS ── */
    .how { max-width: 1100px; margin: 0 auto; padding: 4rem 2rem; }
    .how-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }
    .how-left h2 { font-size: 1.625rem; margin-bottom: 1rem; }
    .how-left p { color: var(--text-mid); margin-bottom: 1.5rem; }

    .tips-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .tip {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1rem 1.25rem;
      background: #fff;
      border: 1.5px solid var(--sage-pale);
      border-radius: 14px;
    }
    .tip-icon {
      width: 36px; height: 36px;
      background: var(--yellow);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      flex-shrink: 0;
    }
    .tip-text strong {
      display: block;
      font-size: 0.9rem;
      color: var(--sage-dark);
      margin-bottom: 0.15rem;
    }
    .tip-text span {
      font-size: 0.8125rem;
      color: var(--text-muted);
    }

    /* ── LEAD MAGNET ── */
    .lead-magnet {
      background: var(--sage-dark);
      padding: 5rem 2rem;
      position: relative;
      overflow: hidden;
    }
    .lead-magnet::before {
      content: '';
      position: absolute;
      top: -60px; right: -60px;
      width: 300px; height: 300px;
      background: var(--yellow);
      border-radius: 50%;
      opacity: 0.08;
    }
    .lead-magnet::after {
      content: '';
      position: absolute;
      bottom: -80px; left: -40px;
      width: 240px; height: 240px;
      background: var(--sage-light);
      border-radius: 50%;
      opacity: 0.1;
    }
    .lead-magnet-inner {
      max-width: 560px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 1;
    }
    .lead-magnet .pill {
      display: inline-block;
      background: rgba(240,196,25,0.2);
      color: var(--yellow);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.4rem 1rem;
      border-radius: 100px;
      margin-bottom: 1.25rem;
    }
    .lead-magnet h2 {
      color: var(--cream);
      font-size: 2rem;
      margin-bottom: 0.75rem;
    }
    .lead-magnet p {
      color: var(--sage-pale);
      margin-bottom: 2rem;
      font-size: 1rem;
    }
    .email-form {
      display: flex;
      gap: 0.75rem;
      background: rgba(255,255,255,0.1);
      border: 1.5px solid rgba(255,255,255,0.15);
      border-radius: 100px;
      padding: 0.4rem 0.4rem 0.4rem 1.25rem;
    }
    .email-form input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: #fff;
      font-family: "DM Sans", sans-serif;
      font-size: 0.9375rem;
    }
    .email-form input::placeholder { color: var(--sage-pale); opacity: 0.7; }
    .email-form button {
      background: var(--yellow);
      color: var(--text-dark);
      font-family: "DM Sans", sans-serif;
      font-weight: 700;
      font-size: 0.875rem;
      border: none;
      border-radius: 100px;
      padding: 0.75rem 1.5rem;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s;
    }
    .email-form button:hover { background: var(--yellow-deep); }

    .form-note {
      font-size: 0.75rem;
      color: var(--sage-pale);
      opacity: 0.7;
      margin-top: 0.75rem;
    }

    /* ── ABOUT ── */
    .about { max-width: 1100px; margin: 0 auto; padding: 4rem 2rem; }
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
    .about-img {
      aspect-ratio: 1;
      background: var(--sage-pale);
      border-radius: 24px;
      position: relative;
      overflow: hidden;
    }
    .about-img::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, var(--sage-light) 1.5px, transparent 1.5px);
      background-size: 18px 18px;
      opacity: 0.3;
    }
    .about-img-placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      color: var(--text-muted);
    }
    .about-content h2 { font-size: 1.75rem; margin-bottom: 1.25rem; }
    .about-content p { color: var(--text-mid); margin-bottom: 1rem; }
    .about-content p:last-of-type { margin-bottom: 1.5rem; }

    /* ── FOOTER ── */
    footer {
      background: var(--text-dark);
      color: var(--sage-pale);
      padding: 3rem 2rem;
    }
    .footer-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.5rem;
    }
    .footer-logo {
      font-family: "Lora", serif;
      font-size: 1.125rem;
      font-weight: 700;
      color: #fff;
    }
    .footer-links {
      display: flex;
      gap: 1.5rem;
      list-style: none;
      margin: 0; padding: 0;
    }
    .footer-links a {
      font-size: 0.875rem;
      color: var(--sage-pale);
      transition: color 0.2s;
    }
    .footer-links a:hover { color: var(--yellow); }
    .footer-cta-row {
      display: flex;
      gap: 0.75rem;
    }
    footer .btn-primary {
      font-size: 0.875rem;
      padding: 0.65rem 1.35rem;
    }
    .footer-copy {
      max-width: 1100px;
      margin: 2rem auto 0;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255,255,255,0.08);
      font-size: 0.8rem;
      color: var(--sage-mid);
      text-align: center;
    }

    /* ── ANIMATIONS ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .hero-content { animation: fadeUp 0.6s ease both; }
    .hero-image-wrap { animation: fadeUp 0.6s 0.15s ease both; }

    /* ── RESPONSIVE ── */
    @media (max-width: 768px) {
      .hero { grid-template-columns: 1fr; padding: 3rem 1.25rem 2.5rem; gap: 2rem; }
      .hero-badge { left: auto; right: 1rem; bottom: -1rem; }
      .recipe-grid { grid-template-columns: 1fr; }
      .cat-grid { grid-template-columns: 1fr 1fr; }
      .how-grid { grid-template-columns: 1fr; gap: 2rem; }
      .about-grid { grid-template-columns: 1fr; }
      .email-form { flex-direction: column; border-radius: 16px; padding: 1rem; }
      .email-form button { border-radius: 100px; }
      .footer-inner { flex-direction: column; text-align: center; }
      .footer-links { justify-content: center; }
      nav { padding: 0 1.25rem; }
      .nav-links { gap: 1.25rem; }
    }
  </style>
  </head>
  <body>
    <TopNav />
	<slot />
  </body>
</html>

