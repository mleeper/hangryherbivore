---
import Layout from '../layouts/Layout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getPageData } from '../lib/api.js';
import "../styles/homepage.css"

const homepage = await getPageData('home');
const { results = [] } = homepage;
const {
    hero_title,
    hero_subtitle,
    hero_image,
    hero_cta,
    value_bar,
    how_it_works_title,
    how_it_works_text,
    how_it_works_cta,
    how_it_works_list,
    about_title,
    about_content,
    about_cta,
    email_signup_title,
    email_signup_content,
    email_signup_button_text,
    categories,
    featured_recipes,
    meta,
} = results[0];
---

<Layout
    title={meta?.title}
    description={hero_subtitle}
    heroImage={hero_image?.url}
    showLeadMagnet={true}
    leadMagnet={{
        title: email_signup_title,
        content: email_signup_content,
        buttonText: email_signup_button_text
    }}
>

    <!-- HERO -->
    <section class="hero">
        <div class="hero-content">
            <span class="hero-eyebrow">🌱 Plant-based on a budget</span>
            <h1>{hero_title}</h1>
            <p>{hero_subtitle}</p>
            <div class="btn-row">
                {hero_cta && hero_cta.map(cta => (
                    <a href={cta.link} class="btn-primary">{cta.text}</a>
                ))}
            </div>
        </div>

        <div class="hero-image-wrap">
            {hero_image ? (
                <img src={hero_image.url} alt={hero_title} class="hero-img" />
            ) : (
                <div class="hero-img-placeholder"></div>
            )}
            <div class="hero-badge">
                <span class="badge-num">200+</span>
                <span class="badge-label">Free Recipes</span>
            </div>
        </div>
    </section>

    <!-- VALUE BAR -->
    <div class="value-bar">
        <div class="value-bar-inner">
            {value_bar?.map((item, i) => (
                <>
                    <span>{item.icon} {item.text}</span>
                    {i < value_bar.length - 1 && <span class="divider"></span>}
                </>
            ))}
        </div>
    </div>

    <!-- FEATURED RECIPES -->
    {featured_recipes?.length > 0 && (
        <section class="featured">
            <div class="section-header">
                <h2>Start With These Budget Staples</h2>
                <a href="/recipes">View all recipes →</a>
            </div>
            <div class="recipe-grid">
                {featured_recipes.map(recipe => (
                    <RecipeCard recipe={recipe} />
                ))}
            </div>
        </section>
    )}

    <!-- CATEGORIES -->
    {categories?.length > 0 && (
        <section class="categories">
            <div class="categories-inner">
                <div class="section-header">
                    <h2>Browse by Category</h2>
                    <a href="/recipes">All categories →</a>
                </div>
                <div class="cat-grid">
                    {categories.map(cat => (
                        <a href={`/recipes?category=${cat.slug}`} class="cat-card">
                            <div class="cat-icon">{cat.icon}</div>
                            <div>
                                <h3>{cat.name}</h3>
                                {cat.description && <p>{cat.description}</p>}
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    )}

    <!-- HOW IT WORKS -->
    <section class="how">
        <div class="how-grid">
            <div class="how-left">
                <h2>{how_it_works_title}</h2>
                <p>{how_it_works_text}</p>
                {how_it_works_cta?.map(cta => (
                    <a href={cta.link} class="btn-outline">{cta.text}</a>
                ))}
            </div>
            <div class="tips-list">
                {how_it_works_list?.map(item => (
                    <div class="tip">
                        <div class="tip-icon">{item.icon}</div>
                        <div class="tip-text">
                            <strong>{item.title}</strong>
                            <span>{item.text}</span>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ABOUT -->
    <section class="about">
        <div class="about-grid">
            <div class="about-img-placeholder"></div>
            <div class="about-content">
                <h2>{about_title}</h2>
                <div set:html={about_content} />
                {about_cta?.map(cta => (
                    <a href={cta.link} class="btn-outline">{cta.text}</a>
                ))}
            </div>
        </div>
    </section>
</Layout>