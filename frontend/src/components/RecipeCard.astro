---
interface Props {
    recipe: {
        title: string;
        slug: string;
        excerpt?: string;
        cook_time?: number;
        cost_per_serving?: number;
        category?: { name: string; slug: string; };
        hero_image?: { url: string; };
        badge?: string;
    }
}

const { recipe } = Astro.props;
---

<a href={`/recipes/${recipe.slug}`} class="recipe-card">
    <div class="card-img">
        {recipe.hero_image ? (
            <img src={recipe.hero_image.url} alt={recipe.title} />
        ) : (
            <div class="img-placeholder"></div>
        )}
        {recipe.badge && (
            <span class="card-badge">{recipe.badge}</span>
        )}
    </div>
    <div class="card-body">
        {recipe.category && (
            <div class="card-category">{recipe.category.name}</div>
        )}
        <h3>{recipe.title}</h3>
        {recipe.excerpt && <p class="card-desc">{recipe.excerpt}</p>}
        <div class="card-meta">
            {recipe.cook_time && (
                <span class="meta-tag">⏱ {recipe.cook_time} min</span>
            )}
            {recipe.cost_per_serving && (
                <span class="meta-tag cost">💸 ${recipe.cost_per_serving}/serving</span>
            )}
        </div>
    </div>
</a>

<style>
    .recipe-card {
        background: #fff;
        border-radius: 20px;
        border: 1.5px solid var(--sage-pale);
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
        display: flex;
        flex-direction: column;
    }

    .recipe-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(61,79,28,0.1);
        border-color: var(--sage-light);
    }

    .card-img {
        aspect-ratio: 16/10;
        position: relative;
        overflow: hidden;
        background: var(--sage-wash);
    }

    .card-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .img-placeholder {
        width: 100%;
        height: 100%;
        background: var(--sage-pale);
    }

    .card-badge {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        background: var(--yellow);
        color: var(--text-dark);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 0.25rem 0.65rem;
        border-radius: 100px;
    }

    .card-body {
        padding: 1.1rem 1.25rem 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .card-category {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 0.4rem;
    }

    .card-body h3 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--sage-dark);
        margin-bottom: 0.5rem;
        transition: color 0.2s;
    }

    .recipe-card:hover h3 { color: var(--sage-mid); }

    .card-desc {
        font-size: 0.8125rem;
        color: var(--text-muted);
        line-height: 1.55;
        margin-bottom: 0.9rem;
        flex: 1;
    }

    .card-meta {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: auto;
    }

    .meta-tag {
        background: var(--sage-wash);
        color: var(--sage-mid);
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.25rem 0.65rem;
        border-radius: 100px;
    }

    .meta-tag.cost {
        background: rgba(240,196,25,0.18);
        color: var(--yellow-deep);
    }
</style>