---
interface Props {
    trigger?: string;
}
const { trigger } = Astro.props;
---
<div class="sliding-panel-wrapper">
    <button id="trigger" class="sliding-panel-trigger">{trigger}</button>
    <div id="sliding-panel-container" class="sliding-panel-container">
        <div class="button-container">
            <button id="closebtn" class="closebtn">&times;</button>
        </div>
        <div id="sliding-panel-content">
            <slot />
        </div>
    </div>
</div>


<script>
    const triggerElement = document.getElementById('trigger');
    const closeElement = document.getElementById('closebtn');
    const mainElement = document.getElementById('main');
    const panelContainerElement = document.getElementById('sliding-panel-container');

    const isMobile = () => window.innerWidth < 768;

    function open() {
        const width = isMobile() ? '100vw' : '50vw';
        panelContainerElement.style.width = width;
        if (!isMobile()) mainElement.style.marginLeft = width;
        document.body.style.overflow = isMobile() ? 'hidden' : '';
    }

    function close() {
        panelContainerElement.style.width = '0';
        mainElement.style.marginLeft = '0';
        document.body.style.overflow = '';
    }

    triggerElement?.addEventListener('click', open);
    closeElement?.addEventListener('click', close);

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
        if (
            panelContainerElement.style.width !== '0' &&
            panelContainerElement.style.width !== '' &&
            !panelContainerElement.contains(e.target) &&
            e.target !== triggerElement
        ) {
            close();
        }
    });
</script>

<style>
    .sliding-panel-wrap {
        display: inline-block;
    }

    .sliding-panel-trigger {
        background: var(--yellow);
        color: var(--text-dark);
        font-family: "DM Sans", sans-serif;
        font-size: 0.875rem;
        font-weight: 700;
        padding: 0.65rem 1.25rem;
        border-radius: 100px;
        border: none;
        cursor: pointer;
        transition: background 0.2s;
    }

    .sliding-panel-trigger:hover {
        background: var(--yellow-deep);
    }

    .sliding-panel-container {
        height: 100%;
        width: 0;
        position: fixed;
        z-index: 200;
        top: 0;
        left: 0;
        overflow-x: hidden;
        overflow-y: auto;
        transition: width 0.3s ease;
        padding-top: 60px;
        background: var(--cream);
        border-right: 1.5px solid var(--sage-pale);
        box-shadow: 4px 0 24px rgba(0,0,0,0.08);
    }

    .button-container {
        position: sticky;
        top: 0;
        height: 50px;
        background: var(--cream);
        border-bottom: 1.5px solid var(--sage-pale);
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 0 1.25rem;
        z-index: 1;
    }

    .closebtn {
        background: none;
        border: none;
        font-size: 1.5rem;
        color: var(--text-muted);
        cursor: pointer;
        line-height: 1;
        padding: 0.25rem;
        transition: color 0.2s;
        font-family: "DM Sans", sans-serif;
    }

    .closebtn:hover { color: var(--sage-dark); }

    #sliding-panel-content {
        padding: 1.5rem;
    }

    @media (max-width: 768px) {
        .sliding-panel-container {
            width: 0;
        }
    }
</style>