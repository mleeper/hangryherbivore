---
const navLinks = [
    { label: 'Recipes', href: '/recipes' },
    { label: 'Blog', href: '/blog' },
];

const currentPath = Astro.url.pathname;
---

<nav>
    <ul class="nav-links">
        {navLinks.map(link => (
            <li>
                <a
                    href={link.href}
                    class={currentPath.startsWith(link.href) ? 'active' : ''}
                >
                    {link.label}
                </a>
            </li>
        ))}
    </ul>

    <a href="/" class="nav-logo">
        <span class="leaf"></span>
        Hangry Herbivore
    </a>

    <a href="/meal-plan" class="nav-cta">Get $40 Meal Plan</a>
</nav>

<style>
    nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--cream);
        border-bottom: 1.5px solid var(--sage-pale);
        padding: 0 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
    }

    .nav-links {
        display: flex;
        gap: 2rem;
        list-style: none;
    }

    .nav-links a {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-mid);
        letter-spacing: 0.02em;
        transition: color 0.2s;
    }

    .nav-links a:hover,
    .nav-links a.active {
        color: var(--sage-dark);
    }

    .nav-links a.active {
        font-weight: 700;
        border-bottom: 2px solid var(--yellow);
        padding-bottom: 2px;
    }

    .nav-logo {
        font-family: "Lora", serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--sage-dark);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .leaf {
        width: 28px;
        height: 28px;
        background: var(--yellow);
        border-radius: 50% 50% 50% 0;
        transform: rotate(-45deg);
        display: inline-block;
        flex-shrink: 0;
    }

    .nav-cta {
        background: var(--yellow);
        color: var(--text-dark);
        font-size: 0.8125rem;
        font-weight: 700;
        padding: 0.5rem 1.1rem;
        border-radius: 100px;
        transition: background 0.2s;
    }

    .nav-cta:hover { background: var(--yellow-deep); }

    @media (max-width: 768px) {
        nav { padding: 0 1.25rem; }
        .nav-links { gap: 1.25rem; }
    }
</style>